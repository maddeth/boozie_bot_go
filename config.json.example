{
  "_comment_twitch": "Twitch Application credentials — create at https://dev.twitch.tv/console/apps",
  "clientId": "YOUR_TWITCH_CLIENT_ID",
  "clientSecret": "YOUR_TWITCH_CLIENT_SECRET",

  "_comment_secret": "Random string used for EventSub webhook HMAC verification (generate any random 20+ char string)",
  "secret": "YOUR_EVENTSUB_WEBHOOK_SECRET",

  "_comment_obs": "OBS WebSocket connection (optional — for scene/source control)",
  "obsPassword": "YOUR_OBS_WEBSOCKET_PASSWORD",
  "obsIP": "ws://localhost:4455",

  "_comment_web": "Public URL where the bot is accessible (used for EventSub webhook callbacks)",
  "webAddress": "https://yourdomain.com",

  "_comment_ports": "HTTP and WebSocket server ports",
  "port": 3000,
  "webSocketPort": 3001,

  "_comment_channel": "Your Twitch channel name (lowercase) and user IDs",
  "myChannel": "your_channel_name",
  "myChannelUserId": "YOUR_CHANNEL_USER_ID",
  "boozieBotUserID": "YOUR_BOT_ACCOUNT_USER_ID",

  "_comment_eggs": "Points distribution interval in milliseconds (900000 = 15 minutes)",
  "eggUpdateInterval": 900000,

  "_comment_points": "Customise the name of your channel points/currency (defaults: points/point/🪙)",
  "pointsName": "points",
  "pointsNameSingular": "point",
  "pointsEmoji": "🪙",

  "_comment_openai": "OpenAI API key (optional — for ChatGPT integration)",
  "openai": {
    "apiKey": "YOUR_OPENAI_API_KEY"
  },

  "_comment_spotify": "Spotify Web API (optional — for now-playing overlay + !sr song requests). Requires Spotify Premium. Register an app at https://developer.spotify.com/dashboard, set redirectUri there to match. Then visit https://yourdomain.com/api/spotify/auth once as broadcaster to authorize.",
  "spotify": {
    "enabled": false,
    "clientId": "YOUR_SPOTIFY_CLIENT_ID",
    "clientSecret": "YOUR_SPOTIFY_CLIENT_SECRET",
    "redirectUri": "https://yourdomain.com/api/spotify/callback",
    "songRequestCost": 100,
    "songRequestCooldownSeconds": 60,
    "maxTrackDurationSeconds": 600,
    "duplicateCooldownSeconds": 3600
  }
}
